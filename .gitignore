# No binaries in git, with one exception. Release assets live in GitHub
# Releases; the bootstrap installs the exe under %LOCALAPPDATA%, not here.
*.exe
*.dll
*.mcpb
*.zip
*.msi
bin/
node_modules/

# The exception: the Claude Code plugin ships the release exe in
# claude-plugin/server/ (the plugin directory refuses a download-and-run
# launcher; a top-level bin/ is reserved). Only release.yml puts it here;
# validate-dist.mjs checks its SHA256 against its release-manifest.json and
# that git does not ignore it.
!claude-plugin/server/accessmcp.exe

# Access artifacts never belong in the public dist repo
*.accdb
*.mdb
*.laccdb
*.adp

# local scratch
*.log
.DS_Store
